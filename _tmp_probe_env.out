61:      - DB_DRIVER=postgres
62:      - DB_HOST=postgres
161:      # 若不设置则自动生成并持久化到 data-files volume（/data/files/.crypto_state.json）
184:      postgres:
222:    volumes:
256:  postgres:
258:    container_name: WeKnora-postgres
265:    volumes:
266:      - postgres-data:/var/lib/postgresql/data
298:    volumes:
315:    volumes:
350:    command: server --console-address ":9001" /data
351:    volumes:
352:      - minio_data:/data
380:    volumes:
381:      - jaeger_data:/var/lib/jaeger # 持久化 Jaeger 数据
392:    volumes:
393:      - neo4j-data:/data
416:    volumes:
445:    volumes:
446:      - milvus_data:/var/lib/milvus
468:    volumes:
469:      - weaviate_data:/var/lib/weaviate
502:    volumes:
522:    volumes:
536:    volumes:
546:  # 为了最小化资源占用，Langfuse 会复用 WeKnora 已有的 postgres 和 redis：
547:  #   - postgres：在 WeKnora-postgres 中创建独立的 "langfuse" 数据库
561:  # 一次性初始化脚本：在已有的 WeKnora-postgres 里创建 langfuse 数据库（幂等，数据库已存在则跳过）
562:  # 复用 WeKnora-postgres 的 ParadeDB 镜像，避免多拉一个 postgres 镜像
567:      postgres:
577:        echo "[langfuse-db-init] ensuring database '${LANGFUSE_DB_NAME:-langfuse}' exists in WeKnora-postgres..."
579:        psql -h postgres -U ${DB_USER} -d postgres -v ON_ERROR_STOP=0 -c "ALTER DATABASE template1 REFRESH COLLATION VERSION;" >/dev/null 2>&1 || true
580:        psql -h postgres -U ${DB_USER} -d postgres -v ON_ERROR_STOP=0 -c "ALTER DATABASE postgres REFRESH COLLATION VERSION;" >/dev/null 2>&1 || true
582:        if psql -h postgres -U ${DB_USER} -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='${LANGFUSE_DB_NAME:-langfuse}'" | grep -q 1; then
585:          psql -h postgres -U ${DB_USER} -d postgres -v ON_ERROR_STOP=1 -c "CREATE DATABASE \"${LANGFUSE_DB_NAME:-langfuse}\" TEMPLATE template0;"
605:    volumes:
606:      - langfuse_clickhouse_data:/var/lib/clickhouse

